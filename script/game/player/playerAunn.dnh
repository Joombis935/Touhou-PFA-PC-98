#TouhouDanmakufu[Player]
#ScriptVersion[3]
#Title["Aunn Komano"]
#Text["Fluffy-headed Shinto Guardian"]
#ID["Aunn"]
#ReplayName["Aunn"]

#include "script/game/lib/playerlib/lib_Player.dnh"

int _count = 0;
int _countShot = 0;
int _objShotDelete;  //Player shot delete effect list

@Initialize{
    //Player properties, rendering, etc.
    TPlayerInit(IMG_PLAYER_AUNN, DIR_LIB ~ "playerlib/dat_ShotAunn.dnh", [3.6, 1.84]);

    //Player shots and options
    TPlayerShot();
    TOption(-26, 20);
    TOption(-12, 30);
    TOption(12, 30);
    TOption(26, 20);

    //Particle list initialization
    _objShotDelete = InitParticleList2D(IMG_PLAYER_AUNN, [0, 0, 16, 16], RP_STG_EFF_PLR_LOW);
    ObjParticleList_SetShader(_objShotDelete, 16 / GetTextureWidth(IMG_PLAYER_AUNN), 16 / GetTextureHeight(IMG_PLAYER_AUNN));
}

@Event{ TPlayerEvent(); }

@MainLoop{
    _count++;
    if(Player_IsAlive() && Player_IsShooting && !IsPlayerSpellActive()) _countShot++;
    else _countShot = -1;
    if(Player_IsAlive()) SetPlayerItemScope(GetVirtualKeyState(VK_SLOWMOVE) == KEY_HOLD ? itemScope[1] : itemScope[0]);
    yield;
}

@Finalize{}

//--------------------------------------------------------------------------------------------------------
//Shot and Options
//--------------------------------------------------------------------------------------------------------
//Standard player shots
task TPlayerShot(){
    loop{
        if(Player_IsAlive && Player_IsShooting() && !IsPlayerSpellActive() && _countShot % 16 == 0){
            loop(3){
                CreatePlayerShotA1(GetPlayerX() - 7, GetPlayerY() - 8, 14, 270, 1.2, 1, 1);
                CreatePlayerShotA1(GetPlayerX() + 7, GetPlayerY() - 8, 14, 270, 1.2, 1, 1);   
                PlayStageSFX(SE_PLRSHOT, GetPlayerX());
                wait(5);
            }

            _count++;
        }

        yield;
    }
}


//Option handling
task TOption(int _distX, int _distY){
    //Initializing option object
    int objOption = InitSprite2D(0, 0, IMG_PLAYER_AUNN, [0, 48, 16, 64], RP_STG_PLAYER + 1);
    ObjSprite2D_SetDestCenter(objOption);

    //Dist
    float mulX = 1;
    float mulY = 1;  //Focus/unfocus distance multiplier

    TOptionShot(objOption, _distX);

    while(!Obj_IsDeleted(objPlayer)){
        //Focused : unfocused
        mulX = GetVirtualKeyState(VK_SLOWMOVE) != KEY_FREE ? 0.75 : 1;
        mulY = GetVirtualKeyState(VK_SLOWMOVE) != KEY_FREE ? -0.75 : 1;

        ObjRender_SetPosition(objOption, GetPlayerX + (_distX * mulX), GetPlayerY + (_distY * mulY), 1);
        Obj_SetVisible(objOption, Player_IsAlive());
        yield;
    }
}

