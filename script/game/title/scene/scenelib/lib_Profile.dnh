//Library for profile utility functions

//Option indices
const int INDEX_PROLOGUE = 0;
const int INDEX_REIMU    = 1;
const int INDEX_MARISA   = 2;
const int INDEX_AUNN     = 3;
const int INDEX_ELENA    = 4;
const int INDEX_LOTTIE   = 5;
const int INDEX_TAKARA   = 6;

//-------------------------------------------------------------------------------------------
//Utility
//-------------------------------------------------------------------------------------------
//Retrieving character portraits by ID
function<string> GetCharacterPortrait(int _index){
    string path = "";
    alternative(_index)
    case(INDEX_PROLOGUE) path = IMG_PORTRAIT_PROLOGUE;
    case(INDEX_REIMU)    path = IMG_PORTRAIT_REIMU;
    case(INDEX_MARISA)   path = IMG_PORTRAIT_MARISA;
    case(INDEX_AUNN)     path = IMG_PORTRAIT_AUNN;
    case(INDEX_ELENA)    path = IMG_PORTRAIT_ELENA;
    case(INDEX_LOTTIE)   path = IMG_PORTRAIT_LOTTIE;
    case(INDEX_TAKARA)   path = IMG_PORTRAIT_TAKARA;
    return path;
}

//Retrieving article body text (the actual profile/prologue)
function<string[]> GetArticleText(int _index){
    string[] path = [];
    alternative(_index)  //30 character line-limit
    case(INDEX_PROLOGUE){
        path = ["\"Miss Reimu, Miss Reimu,", "wake up!\"", "",
                "The Hakurei Shrine.", "The abundant leaves that had", "blazed brilliant-orange just",
                "weeks ago had already begun", "to fall on the shrine's", "cobblestone path, and with",
                "the ripping brisk of a chilly", "breeze settling in, autumn had", "finally arrived in Gensokyo.",
                "The shrine maiden had been", "tending to her usual duties,", "polishing the beams of the",
                "torii gate and sweeping away", "the fallen leaves when she", "decided to take a",
                "well-earned(?) break and", "passed out in the shade of", "the veranda. Evidently,",
                "she wasn't expecting anyone", "to stumble upon her", "splayed-out form, but today",
                "would not be as ordinarily", "mundane as she had thought.", "", "\"Mmph, hunh?\"",
                "The shrine maiden groggily", "rose from the veranda's steps", "and looked up at her visitor,",
                "rubbing her eyes.", "", "\"Oh, it's just you,", "Kosuzu-chan.\"", "",
                "Kosuzu Motoori, resident", "bibliophile of the Human", "Village's very own Suzunaan.",
                "She stood at the foot of the", "wooden steps, anxiously", "twisting her ginger curls and",
                "clutching a weathered book to", "her chest as she awaited the", "miko's attention.", "",
                "\"What are you doing here? It's", "unlike you to come visit the", "shrine.", "",
                "\"I know, but something really", "big's happening at the village", "that you need to see!\"",
                "Kosuzu's eyes were wide with", "anticipation.", "", "\"Really? Were you messing",
                "with a demon book again?\"", "Reimu cast a suspicious look", "at the purple tome in the",
                "librarian's arms.", "Kosuzu had a history of", "accidentally releasing",
                "troublesome creatures from", "the youkai-penned books", "lining her family's shelves,",
                "and Reimu and Marisa often", "scolded her for her naivete", "after reluctantly",
                "exterminating whatever she", "had summoned. Ostensibly,", "this seemed to be one of",
                "those occurrences.", "", "\"You know you shouldn't be", "handling demon books,",
                "remember what happened", "last time?\"", "", "I-I wasn't doing anything with",
                "demon books!!\" Kosuzu", "stammered, face turning red", "as she turned on her heels to",
                "shove the (obviously", "demonic) manuscript out of", "sight.", "\"A-a-anyway, that's not what I",
                "came to tell you! I mean,", "there's something really", "important going on!\"", "",
                "\"Hmm....well, if this isn't", "nothing, then I'll make us", "some tea. Come in.\"",
