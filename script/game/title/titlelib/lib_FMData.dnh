//Retrieves MIDI filepaths
function MIDI_GetMIDIPath(int _trackID){
    string path;
    alternative(_trackID)
    case(-1) path = "";  //No track
    case(0)  path = "";  //Title theme
    case(1)  path = DIR_BGM ~ "midiStage1.mid";  //Stage 1 theme
    case(2)  path = "";  //Boss 1 theme
    case(3)  path = "";  //Stage 2 theme
    case(4)  path = "";  //Boss 2 theme
    case(5)  path = "";  //Stage 3 theme
    case(6)  path = "";  //Boss 3 theme
    others   path = "";
    return path;
}

//Parses the passed MIDI file
function<void> MIDI_ParseMidi(string _pathMidi){
    //Creating a binary file to read MIDIs as MIDI data is stored in binary
    int objMIDI = ObjFile_Create(OBJ_FILE_BINARY);
    ObjFile_Open(objMIDI, _pathMidi);  //troubleshoot
    ObjFileB_SetByteOrder(objMIDI, ENDIAN_BIG);  //MIDI files use Big Endian for byte order
}