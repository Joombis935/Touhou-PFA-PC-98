//Shot constant sheet

//Normal Shots
//SHOT_COLOR + SHOT_TYPE = SHOT

//Shot delay effects
//SHOT_COLOR + SPAWN_TYPE + SIZE = SPAWN_EFFECT

//Shot cancel effects
//SHOT_COLOR + CANCEL_EFFECT = CANCEL EFFECT

