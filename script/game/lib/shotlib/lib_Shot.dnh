}

//--------------------------------------------------------------
//C-Type Shots
//--------------------------------------------------------------
//Custom C1 shot (B1 shot with speed rotation)
function<int> CreateShotUC1(int _x, int _y, float _speedX, float _speedY, float _off, int _graph, int _graphSpawn, int _graphDelete){
    int shot;
    //If the shot as a valid spawn graphic ID
    if(_graphSpawn >= 1001){
        shot = CreateShotC1(_x, _y, _speedX / 2, _speedY / 2, _off, _graphSpawn, 0);
        ObjMove_AddPatternC3(shot, 20, _speedX, _speedY, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, _graph);
    }
    else shot = CreateShotC1(_x, _y, _speedX, _speedY, _off, _graph, 0);

    SetShotProperty(shot, _graphDelete);
    return shot;
}

//Custom C2 shot (B2 shot with speed rotation and rotation acceleration)
function<int> CreateShotUC2(int _x, int _y, float _speedX, float _speedY, float _accelX, float _accelY, float _maxX, float _maxY, float _off, float _offAccel, int _graph, int _graphSpawn, int _graphDelete){
    int shot;
    //If the shot as a valid spawn graphic ID
    if(_graphSpawn >= 1001){
        shot = CreateShotC2(_x, _y, _speedX / 2, _speedY / 2, _accelX, _accelY, _maxX, _maxY, _off, _offAccel, _graphSpawn, 0);
        ObjMove_AddPatternC3(shot, 20, _speedX, _speedY, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, _graph);
    }
    else shot = CreateShotC2(_x, _y, _speedX, _speedY, _accelX, _accelY, _maxX, _maxY, _off, _offAccel, _graph, 0);

    SetShotProperty(shot, _graphDelete);
    return shot;
}

//--------------------------------------------------------------------------------------------------------
//Pattern Shot Functions
//--------------------------------------------------------------------------------------------------------
//Creates a pattern shot with the given settings at the base point
function<int> Shot_CreatePatternShot(int _x, int _y, int _type, int _way, int _stack, float _baseA, float _argA, float _baseS, float _argS, float _rad, int _delay){
    int obj = ObjPatternShot_Create();
    ObjPatternShot_SetShotType(obj, OBJ_SHOT);
    ObjPatternShot_SetBasePoint(obj, _x, _y);
    ObjPatternShot_SetPatternType(obj, _type);
    ObjPatternShot_SetShotCount(obj, _way, _stack);
    ObjPatternShot_SetAngle(obj, _baseA, _argA);
    ObjPatternShot_SetSpeed(obj, _baseS, _argS);
    ObjPatternShot_SetShootRadius(obj, _rad);
    ObjPatternShot_SetDelay(obj, _delay);
    return obj;
}

//Overload with parent object
function<int> Shot_CreatePatternShot(int _parent, int _type, int _way, int _stack, float _baseA, float _argA, float _baseS, float _argS, float _rad, int _delay){
    int obj = ObjPatternShot_Create();
    ObjPatternShot_SetShotType(obj, OBJ_SHOT);
    ObjPatternShot_SetParentObject(obj, _parent);
    ObjPatternShot_SetPatternType(obj, _type);
    ObjPatternShot_SetShotCount(obj, _way, _stack);
    ObjPatternShot_SetAngle(obj, _baseA, _argA);
    ObjPatternShot_SetSpeed(obj, _baseS, _argS);
    ObjPatternShot_SetShootRadius(obj, _rad);
    ObjPatternShot_SetDelay(obj, _delay);
    return obj;
}

//Fire the passed pattern shot without spawn animation
function<int[]> Shot_FirePatternShot(int _obj, int _graph, int _graphDelete){
    ObjPatternShot_SetGraphic(_obj, _graph);
    int[] arrShots = ObjPatternShot_FireReturn(_obj);

    for each(shot in arrShots){
        ObjShot_SetAngleRounding(shot, 11.25);
        Obj_SetValueI(shot, SHOT_EFFECT, _graphDelete);
    }

    return arrShots;
}

//Overload with spawn animation
function<int[]> Shot_FirePatternShot(int _obj, int _graph, int _graphSpawn, int _graphDelete){
    ObjPatternShot_SetGraphic(_obj, _graphSpawn);
    int[] arrShots = ObjPatternShot_FireReturn(_obj);

    for each(shot in arrShots){
        float speed = ObjMove_GetSpeed(shot);
        ObjMove_SetSpeed(shot, speed / 2);
        ObjMove_AddPatternA3(shot, 20, speed, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, _graph);
        ObjShot_SetAngleRounding(_shot, 11.25);
        Obj_SetValueI(shot, SHOT_EFFECT, _graphDelete);
    }

    return arrShots;
}

//--------------------------------------------------------------------------------------------------------
//Polygon Shot Functions
//--------------------------------------------------------------------------------------------------------
//Fire a polygon shot and return an array of the shots fired
function<int[]> Shot_PolygonShot(float _x, float _y, float _speed, float _angle, float _rad, int _sides, int _way, float[] _angleSides, int _graph, int _graphSpawn, int _graphDelete){
    int[] arrShot = [];
    float[] x = [];
    float[] y = [];
    float[] speedX = [];
    float[] speedY = [];
    float nextX;
    float nextY;
    float xNext;
    float yNext;
    assert(_sides >= 3, "Attempted to fire a polygon shot with less than 3 sides.");

    ascent(i in 0.._sides){
        speedX ~= [_speed * cos(_angle + _angleSides[i])];
        speedY ~= [_speed * sin(_angle + _angleSides[i])];
        x ~= [_x + _rad * speedX[i]];
        y ~= [_y + _rad * speedY[i]];
    }

    ascent(i in 0.._sides){
        //Polygon vertex shots
        arrShot ~= [CreateShotUB1(x[i], y[i], speedX[i], speedY[i], _graph, _graphSpawn, _graphDelete)];

        //Next vertex shot to interpolate angles and component speeds to
        nextX = speedX[i == (_sides - 1) ? 0 : i + 1];
        nextY = speedY[i == (_sides - 1) ? 0 : i + 1];
        xNext = x[i == (_sides - 1) ? 0 : i + 1];
        yNext = y[i == (_sides - 1) ? 0 : i + 1];
        //Shots that make up the side of the polygon
        ascent(g in 1.._way){
            arrShot ~= [CreateShotUB1(Interpolate_Linear(x[i], xNext, g / _way), Interpolate_Linear(y[i], yNext, g / _way), Interpolate_Linear(speedX[i], nextX, g / _way), Interpolate_Linear(speedY[i], nextY, g / _way), _graph, _graphSpawn, _graphDelete)];
        }
    }

    return arrShot;
}