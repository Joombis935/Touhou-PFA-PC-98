//Custom B2 shot (component speeds with accelerations and speed caps)
function<int> CreateShotUB2(int _x, int _y, float _speedX, float _speedY, float _accelX, float _accelY, float _maxX, float _maxY, int _graph, int _graphSpawn, int _graphDelete){
