//Library of custom shot functions
#include "./lib_Laser.dnh"
#include "./dat_ShotConstant.dnh"

string _shot = "script/game/lib/shotlib/dat_Shot.dnh";
string _shotAnim = "script/game/lib/shotlib/dat_ShotAnim.dnh";
string _shotSpawn = "script/game/lib/shotlib/dat_ShotSpawn.dnh";

//--------------------------------------------------------------------------------------------------------
//Initialization and Properties
//--------------------------------------------------------------------------------------------------------
function<void> Shot_ShotInit(){
    //Shot data
    LoadEnemyShotData(_shot);
    LoadEnemyShotData(_shotAnim);
    LoadEnemyShotData(_shotSpawn);
}

//Shortcut in functions themselves
function<void> SetShotProperty(int _shot, int _graphDelete){
    ObjShot_SetPositionRounding(_shot, true);
    ObjShot_SetAngleRounding(_shot, 11.25);  //PC-98 shots only have 32 directional sprites
    Obj_SetValueI(_shot, SHOT_EFFECT, _graphDelete);
}

//If shot is within stage frame
function<bool> Shot_IsInBounds(int _obj){               return (ObjMove_GetX(_obj) > 0) && (ObjMove_GetX(_obj) < MAX_X) && (ObjMove_GetY(_obj) > 0) && (ObjMove_GetY(_obj) < MAX_Y); }
//Overload with margin
function<bool> Shot_IsInBounds(int _obj, int _margin){  return (ObjMove_GetX(_obj) > _margin) && (ObjMove_GetX(_obj) < (MAX_X + _margin)) && (ObjMove_GetY(_obj) > _margin) && (ObjMove_GetY(_obj) < (MAX_Y + _margin)); }
//If shot is within x bounds
function<bool> Shot_IsInBoundsX(int _obj){              return (ObjMove_GetX(_obj) > 0) && (ObjMove_GetX(_obj) < MAX_X); }
//Overload with margin
function<bool> Shot_IsInBoundsX(int _obj, int _margin){ return (ObjMove_GetX(_obj) > _margin) && (ObjMove_GetX(_obj) < (MAX_X + _margin)); }
//If shot is within y bounds
function<bool> Shot_IsInBoundsY(int _obj){              return (ObjMove_GetY(_obj) > 0) && (ObjMove_GetY(_obj) < MAX_Y); }
//Overload with margin
function<bool> Shot_IsInBoundsY(int _obj, int _margin){ return (ObjMove_GetY(_obj) > _margin) && (ObjMove_GetY(_obj) < (MAX_Y + _margin)); }

//--------------------------------------------------------------------------------------------------------
//Custom Shot Functions
//--------------------------------------------------------------------------------------------------------

//--------------------------------------------------------------
//A-Type Shots
//--------------------------------------------------------------
//Custom A1 shot (normal speed and angle)
function<int> CreateShotUA1(int _x, int _y, float _speed, float _angle, int _graph, int _graphSpawn, int _graphDelete){
    int shot;
    //If the shot has a valid spawn graphic ID
    if(_graphSpawn >= 1001){
        shot = CreateShotA1(_x, _y, _speed / 2, _angle, _graphSpawn, 0);
        ObjMove_AddPatternA3(shot, 20, _speed, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, _graph);
    }
    else shot = CreateShotA1(_x, _y, _speed, _angle, _graph, 0);

    SetShotProperty(shot, _graphDelete);
    return shot;
}

//Custom A2 shot (speed and angle with acceleration and speed cap)
function<int> CreateShotUA2(int _x, int _y, float _speed, float _angle, float _accel, float _speedMax, float _wvel, int _graph, int _graphSpawn, int _graphDelete){
    int shot;
    //If the shot has a valid spawn graphic ID
    if(_graphSpawn >= 1001){
        shot = CreateShotA2(_x, _y, _speed / 2, _angle, _accel, _speedMax, _wvel, _graphSpawn, 0);
        ObjMove_AddPatternA3(shot, 20, _speed, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, _graph);
    }
    else shot = CreateShotA2(_x, _y, _speed, _angle, _accel, _speedMax, _wvel, _graph, 0);

    SetShotProperty(shot, _graphDelete);
    return shot;
}

