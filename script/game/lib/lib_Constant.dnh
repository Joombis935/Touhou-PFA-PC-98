//Library of constants including filepaths, events, render priorities, etc.

//-----------------------------------------------------------------------
//Debug Mode
//-----------------------------------------------------------------------
const bool MODE_DEBUG                    = false;  //Change this around when troubleshooting

//-----------------------------------------------------------------------
//Game Version
//-----------------------------------------------------------------------
const string GAME_VERSION                = "v0.10a";

//-----------------------------------------------------------------------
//Fonts
//-----------------------------------------------------------------------
const string FONT_PC98                   = "PC-9800";
const string FONT_PC98BIT                = "PC-9800 8Bit";
const string FONT_MAGIC                  = "Magic Decimal Sharp";
const string FONT_MUSIC                  = "MusicZun";
const string FONT_IMPACT                 = "ImpactPixel";
const string FONT_PATH_PC98              = "script/game/img/system/font/PC-9800.ttf";
const string FONT_PATH_PC98BIT           = "script/game/img/system/font/PC-9800-8Bit.ttf";
const string FONT_PATH_MAGIC             = "script/game/img/system/font/MagicDecimalSharp.ttf";
const string FONT_PATH_MUSIC             = "script/game/img/system/font/MusicZUN.ttf";
const string FONT_PATH_IMPACT            = "script/game/img/system/font/impactpixel.ttf";

//-----------------------------------------------------------------------
//Events
//-----------------------------------------------------------------------
//Stage Constants
const int EV_STAGE_START                 = EV_USER_STAGE + 1;   //Starts the dialogue and plural scripts after the intro animations finish
const int EV_STAGE_INTRO_START           = EV_USER_STAGE + 2;   //Stage intro effect fade begins and the player can move/shoot/pause the game
const int EV_CHANGE_BG                   = EV_USER_STAGE + 3;   //Change background index number, pass (index, transitionTime)
const int EV_CONTINUE                    = EV_USER_STAGE + 4;   //Player used a continue
const int EV_IS_SPELL                    = EV_USER_STAGE + 5;   //Transition to spell, pass (bool, transition ID)

//System Constants
const int EV_CREATE_ITEM                 = EV_USER_SYSTEM + 1;  //Creates item, pass (_x, _y, _itemID)
const int EV_CANCEL_BONUS                = EV_USER_SYSTEM + 2;  //Creates score from end-of-spell bullet cancels, pass (_score)
const int EV_POINT_EXTEND                = EV_USER_SYSTEM + 3;  //Gives the player a life without a 1-up item
const int EV_BOMB_EXTEND                 = EV_USER_SYSTEM + 4;  //Gives the player a bomb without a 1-up bomb item
const int EV_BANNER                      = EV_USER_SYSTEM + 5;  //Calls banner from the top, pass (_type, _row, _score,)
const int EV_SHIELD_ACTIVE               = EV_USER_SYSTEM + 6;  //Faith shield active, pass (_boolActive)
const int EV_SHIELD_SETPARAM             = EV_USER_SYSTEM + 7;  //Sets various shield parameters from player script, pass (_maxLevel, _maxTimer)

//Package Constants
const int EV_PLAY_BGM                    = EV_USER_PACKAGE + 1;  //Stops current track (if one is playing), plays new track. pass (bgmID, fade, delay)
const int EV_STOP_BGM                    = EV_USER_PACKAGE + 2;  //Pauses if true, resumes if false.
const int EV_PLAY_SFX                    = EV_USER_PACKAGE + 3;  //Plays sound effects from audio script. pass (sfxID)
const int EV_STOP_SFX                    = EV_USER_PACKAGE + 4;  //Stops currently playing sfx
const int EV_SET_BGM_FADE                = EV_USER_PACKAGE + 5;  //Sets the BGM fade time, pass (_fadeTime)
const int EV_GET_BGM_NAME                = EV_USER_PACKAGE + 6;  //Returns an array of [bgmName, bgmComment]. pass (bgmID)
const int EV_PAUSE_ENABLE                = EV_USER_PACKAGE + 7;  //Enables pausing of the stage script, pass (_enable)
const int EV_STAGE_EVENT                 = EV_USER_PACKAGE + 8;  //Sets the package script stage event, pass (STAGE_EVENT)
const int EV_STAGE_VICTORY               = EV_USER_PACKAGE + 9;  //Runs CloseStgScene() through this event
const int EV_TITLE_END                   = EV_USER_PACKAGE + 10;  //Closes the title screen script

//-----------------------------------------------------------------------
//Stage event Constants
//-----------------------------------------------------------------------
//Stage event types
const int STAGE_NONE                     = 0;  //No event
const int STAGE_PAUSE                    = 1;  //Main game pause
const int STAGE_GAMEOVER                 = 2;  //Main game gameover
const int STAGE_VICTORY                  = 3;  //Main game stage cleared
const int STAGE_PAUSE_SPELL              = 4;  //Spell practice pause
const int STAGE_GAMEOVER_SPELL           = 5;  //Spell failed
const int STAGE_VICTORY_SPELL            = 6;  //Spell cleared
const int STAGE_PAUSE_REPLAY             = 7;  //Replay pause
const int STAGE_END_REPLAY               = 8;  //Replay end
const int STAGE_DIALOGUE                 = 9;  //Start dialogue scene, pass (dialoguePath)

//Script Result Constants
const int RESULT_CONTINUE                = 10; //Player used a continue (game over menu)

//-----------------------------------------------------------------------
//System Constants
//-----------------------------------------------------------------------
//Banner type constants
const int BANNER_BONUS_SPELL             = 0;  //Spell capture bonus
const int BANNER_BONUS_CANCEL            = 1;  //End-of-spell bullet cancel bonus
const int BANNER_BONUS_FAIL              = 2;  //Spell failed
const int BANNER_EXTEND                  = 3;  //Player gains a life
const int BANNER_ACHIEVEMENT             = 4;  //Player gets an achievement
const int BANNER_HIGHSCORE               = 5;  //Player reaches new highscore
const int BANNER_STAGE_CLEAR             = 6;  //Stage cleared
const int BANNER_CONGRATS                = 7;  //Stage 7 or 8 cleared
const int BANNER_SECRET                  = 8;  //Stage 8 requirement reached

//Faith Shield constants
const int SHIELD_END_TIMER               = 0;  //Shield ended by running out the timer
const int SHIELD_END_HIT                 = 1;  //Shield ended by getting hit
const int SHIELD_END_BOMB                = 2;  //Shield ended by bombing

