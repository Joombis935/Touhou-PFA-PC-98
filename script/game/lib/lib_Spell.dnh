//Spell functions library
//Format: SpellSeen/SpellCaptured_MODE_PLAYER_STAGE_SPELL
//History format: SpellSeen, SpellCaptured
#include "./lib_Highscore.dnh"

//-----------------------------------------------------------------------
//General Spell Functions
//-----------------------------------------------------------------------
//Sets the specified spell as seen
function<void> Spell_SetSpellSeen(int _stageID, int _spellID){
    if(IsReplay()) return;
    int mode = GetGameMode();
    int playerID = GetPlayerType();
    int[] history = Spell_GetSpellHistory(mode, playerID, _stageID, _spellID);
    SetAreaCommonData(AREA_SAVE, "SpellSeen_" ~ IntToString(mode) ~ "_" ~ IntToString(playerID) ~ "_" ~ IntToString(_stageID) ~ "_" ~ IntToString(_spellID), history[0] + 1);
}
//Return whether or not the given spell has been seen in the given mode
function<bool> IsSpellSeen(int _modeID, int _stgID, int _plrID, int _spellID){
    return Spell_GetSpellHistory(_modeID, _plrID, _stgID, _spellID)[0] > 0;
}

//Sets the specified spell as captured
function<void> Spell_SetSpellCaptured(int _stageID, int _spellID){
    if(IsReplay()) return;
    int mode = GetGameMode();
    int playerID = GetPlayerType();
    int[] history = Spell_GetSpellHistory(mode, playerID, _stageID, _spellID);
    SetAreaCommonData(AREA_SAVE, "SpellCaptured_" ~ IntToString(mode) ~ "_" ~ IntToString(playerID) ~ "_" ~ IntToString(_stageID) ~ "_" ~ IntToString(_spellID), history[1] + 1);
}

//Returns the specified spell's history
function<int[]> Spell_GetSpellHistory(int _mode, int _playerID, int _stageID, int _spellID){
    int spellSeen = GetAreaCommonData(AREA_SAVE, "SpellSeen_" ~ IntToString(_mode) ~ "_" ~ IntToString(_playerID) ~ "_" ~ IntToString(_stageID) ~ "_" ~ IntToString(_spellID), 0);
    int spellCaptured = GetAreaCommonData(AREA_SAVE, "SpellCaptured_" ~ IntToString(_mode) ~ "_" ~ IntToString(_playerID) ~ "_" ~ IntToString(_stageID) ~ "_" ~ IntToString(_spellID), 0);
    return [spellSeen, spellCaptured];
}

//Sets the current spell being fought
function<void> Spell_SetCurrentSpell(int _spellID){
    assert(_spellID >= 0, IntToString(_spellID) ~ " is an invalid spell ID.");  //Spell IDs can't be less than 0
    SetAreaCommonData(AREA_STAGE, "SpellCurrent", _spellID);
}
//Returns the current spell being fought
function<int> Spell_GetCurrentSpell(){
    return GetAreaCommonData(AREA_STAGE, "SpellCurrent", 0);
}

