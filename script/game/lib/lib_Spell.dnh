//-------------------------------------------------------------------------------------------
//Text Functions
//-------------------------------------------------------------------------------------------
//Returns the spell name along with the different histories and the spell highscore in presentable format
function<string> Spell_GetSpellText(int _stgID, int _plrID, int _rankID, int _spellID){
    string path = "";

    //Spell name
    path ~= Spell_GetSpellName(_stgID, _plrID, _spellID);
    if(path == "") path = "[No Spell Name] ";
    //If spell was not seen
    if(!IsSpellSeen(MODE_MAIN, _stgID, _plrID, _spellID) && path != "[No Spell Name] ") path = "? Unseen in Main Game ?";
    else path ~= IntToString(_stgID + 1) ~ "_" ~ IntToString(_rankID + 1); 

    path ~= "[r]";
    //Main game history
    int[] historyMain = Spell_GetSpellHistory(MODE_MAIN, _plrID, _stgID, _spellID);
    path ~= "MAIN " ~ vtos("02d", min(historyMain[0], 99)) ~ "/" ~ vtos("02d", min(historyMain[1], 99)) ~ " | ";
    //Spell history
    int[] historySpell = Spell_GetSpellHistory(MODE_SPELL, _plrID, _stgID, _spellID);
    path ~= "SPELL " ~ vtos("02d", min(historySpell[0], 99)) ~ "/" ~ vtos("02d", min(historySpell[1], 99)) ~ " | ";
    //Spell practice high score
    string hiScoreField = IntToString(MODE_SPELL) ~ "_" ~ IntToString(_plrID) ~ "_" ~ IntToString(_stgID) ~ "_" ~ IntToString(_spellID);
    int hiScore = HS_GetHighScore(hiScoreField, 0);
    path ~= "HISCORE " ~ vtos("09d", hiScore);

    return path;
}

//Returns the scene name along with the different histories and the scene highscore in presentable format
function<string> Stage_GetSceneText(int _stgID, int _plrID, int _rankID, int _typeID){
    string path = "";

    //Spell name
    path ~= Stage_GetSceneName(_stgID, _plrID, _typeID);
    if(path == "") path = "[No Scene Name] ";
    //If spell was not seen
    if(!IsSceneSeen(MODE_MAIN, _stgID, _plrID, _typeID) && path != "[No Spell Name] ") path = "? Unseen in Main Game ?";
    else path ~= IntToString(_stgID + 1) ~ "_" ~ IntToString(_rankID + 1); 

    path ~= "[r]";
    //Main game history
    int[] historyMain = Stage_GetSceneHistory(MODE_MAIN, _plrID, _stgID, _typeID);
    path ~= "MAIN " ~ vtos("02d", min(historyMain[0], 99)) ~ "/" ~ vtos("02d", min(historyMain[1], 99)) ~ " | ";
    //Scene history
    int[] historySpell = Stage_GetSceneHistory(MODE_SPELL, _plrID, _stgID, _typeID);
    path ~= "SPELL " ~ vtos("02d", min(historySpell[0], 99)) ~ "/" ~ vtos("02d", min(historySpell[1], 99)) ~ " | ";
    //Stage practice high score
    string hiScoreField = IntToString(MODE_SPELL) ~ "_" ~ IntToString(_plrID) ~ "_" ~ IntToString(_stgID) ~ "_" ~ IntToString(_typeID);
    int hiScore = HS_GetHighScore(hiScoreField, 0);
    path ~= "HISCORE " ~ vtos("09d", hiScore);

    return path;
}

//-------------------------------------------------------------------------------------------
//Image / Misc Utility Functions
//-------------------------------------------------------------------------------------------
//Loads/removes the spell panel screenshot textures in the spell practice menu
function<void> LoadSpellPanelTexture(int _boolLoad){
    string dir = DIR_IMG ~ "screenshot/";
    string[] listDir = GetDirectoryList(dir);  //List of the stage directories in the screenshot directory
    string[] listFile;                         //List of files in the current stage directory 

    //Automatically goes through entire screenshot folder and loads/removes all existing textures
    ascent(iDir in 0..length(listDir)){  //Cycle through all existing stages in the directory
        listFile = GetFilePathList(listDir[iDir]);

        //Load/remove all files in the current stage directory
        for each(iFile in listFile){
            if(_boolLoad) LoadTexture(iFile);
            else RemoveTexture(iFile);
        }
    }
}

//Retrieves a spell panel texture in spell practice
function<string> GetSpellPanelTexture(int _plrID, int _stgID, int _spellID){
    string dir = DIR_IMG ~ "screenshot/" ~ "stg" ~ IntToString(_stgID + 1) ~ "/";  //Directory
    string file = "Attack " ~ IntToString(_spellID) ~ "_" ~ IntToString(_plrID) ~ "_" ~ IntToString(_stgID);  //File name
    string path;

    //If the spell wasn't captured or the screenshot file doesn't exist, return unknown spell image
    if(!IsSpellSeen(MODE_MAIN, _stgID, _plrID, _spellID) || !IsFileExists(dir ~ file)) path = IMG_TITLE_SPELLUNKN;
    //Return spell screenshot image
    else path = dir ~ file;
    
    WriteLog(path);
    return path;
}