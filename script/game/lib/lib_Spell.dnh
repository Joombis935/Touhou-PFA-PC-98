//Gets the specified spell's corresponding filepath
function<string> Spell_GetSpellPath(int _stgID, int _plrID, int _spellID){
    string path = "";
    //Directories
    string dir = GetModuleDirectory() ~ "script/game/boss/";
    alternative(_stgID)
    case(STG_1) dir ~= "elena/";
    others assert(false, "Not implemented yet.");
    
    //Spell paths
    alternative(_stgID)
    //Elena
    case(STG_1){
        //alternative(_spellID)
    }
    return path;
}

//Return the list of spell IDs in the plural
function<int[]> Spell_GetSpellIDList(int _stgID, int _plrID){
    int[] list = [];
    int rank = GetDifficulty();

    alternative(_stgID)
    case(STG_1) list ~= [0 + rank, 4 + rank, 8 + rank, 12 + rank];
    others assert(false, "Not implemented yet.");

    return list;
}

//-------------------------------------------------------------------------------------------
//Text Functions
//-------------------------------------------------------------------------------------------
//Return the boss name
function<string> GetBossName(int _stgID, int _plrID, int _rankID){
    string path;
    alternative(_stgID)
    case(STG_1) path = "Elena Whitewood";
    case(STG_2) path = "Lottie Salsola";
    case(STG_3) path = "Takara Viverrino";
    others assert(false, "Not implemented yet.");

    //If stage was not seen
    if(!CD_IsStageSeen(_plrID, _stgID, _rankID)) path = "? Boss Unseen ?";
    return path;
}

//Returns the spell name along with the different histories and the spell highscore in presentable format
function<string> GetSpellText(int _stgID, int _plrID, int _rankID, int _spellID){
    string path = "";

    //Spell name
    path ~= Spell_GetSpellName(_stgID, _plrID, _spellID);
    if(path == "") return path;
    //If spell was not seen
    if(!IsSpellSeen(_stgID, _plrID, _spellID)) path = "? Unseen in Main Game ?";

    path ~= "[r]";
    //Main game history
    int[] historyMain = Spell_GetSpellHistory(MODE_MAIN, _plrID, _stgID, _spellID);
    path ~= "MAIN " ~ vtos("02d", min(historyMain[0], 99)) ~ "/" ~ vtos("02d", min(historyMain[1], 99)) ~ " | ";
    //Spell history
    int[] historySpell = Spell_GetSpellHistory(MODE_SPELL, _plrID, _stgID, _spellID);
    path ~= "SPELL " ~ vtos("02d", min(historySpell[0], 99)) ~ "/" ~ vtos("02d", min(historySpell[1], 99)) ~ " | ";
    //Spell practice high score
    string hiScoreField = IntToString(MODE_SPELL) ~ "_" ~ IntToString(_plrID) ~ "_" ~ IntToString(_stgID) ~ "_" ~ IntToString(_spellID);
    int hiScore = HS_GetHighScore(hiScoreField, 0);
    path ~= "HISCORE " ~ vtos("09d", hiScore);

    return path;
}