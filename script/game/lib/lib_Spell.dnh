//Returns the specified spell's corresponding filepath
function<string> Spell_GetSpellPath(int _stgID, int _plrID, int _spellID){
    //Directories
    string dir = GetModuleDirectory() ~ "script/game/boss/";
    alternative(_stgID)
    case(STG_1) dir ~= "elena/";
    case(STG_2) dir ~= "lottie/";
    case(STG_3) dir ~= "takara/";
    others assert(false, "Not implemented yet.");
    
    //Spell paths
    string path = "";
    alternative(_stgID)
    //Elena
    case(STG_1){
        //alternative(_spellID)
    }
    return path;
}

//Returns the list of spells in the stage
function<string[]> Spell_GetStageSpellList(int _stgID){
    //Directories
    string dir = GetModuleDirectory() ~ "script/game/boss/";    
    alternative(_stgID)
    case(STG_1) dir ~= "elena/";
    case(STG_2) dir ~= "lottie/";
    case(STG_3) dir ~= "takara/";
    others assert(false, "Not implemented yet.");

    //Spell list
    string[] listSpell = [];  //The list of spells
    string[] listFile = GetFilePathList(dir);
    string filePrefix;  //Attack qualifier in file name
    //Check names of files, automatically add to spell list if single script
    for each(iFile in listFile){
        filePrefix = SplitString(GetFileName(iFile), '_')[0];
        if(filePrefix == "single") listSpell ~= [iFile];  //If file name has "single" in beginning, add it to spell list
    }

    return listSpell;
}

//-----------------------------------------------------------------------
//General Stage Functions
//-----------------------------------------------------------------------
//Sets the specified stage as seen
function<void> Stage_SetSceneSeen(int _stageID, int _typeID){
    if(IsReplay()) return;
    int mode = GetGameMode();
    int playerID = GetPlayerType();
    int[] history = Stage_GetSceneHistory(mode, playerID, _stageID, _typeID);
    SetAreaCommonData(AREA_SAVE, "StageSeen_" ~ IntToString(mode) ~ "_" ~ IntToString(playerID) ~ "_" ~ IntToString(_stageID) ~ "_" ~ IntToString(_typeID), history[0] + 1);
}
//Return whether or not the given stage has been seen in the given mode
function<bool> IsSceneSeen(int _modeID, int _stgID, int _plrID, int _typeID){
    return Stage_GetSceneHistory(_modeID, _plrID, _stgID, _typeID)[0] > 0;
}

//Sets the specified stage as cleared
function<void> Stage_SetSceneCleared(int _stageID, int _typeID){
    if(IsReplay()) return;
    int mode = GetGameMode();
    int playerID = GetPlayerType();
    int[] history = Stage_GetSceneHistory(mode, playerID, _stageID, _typeID);
    SetAreaCommonData(AREA_SAVE, "StageCleared_" ~ IntToString(mode) ~ "_" ~ IntToString(playerID) ~ "_" ~ IntToString(_stageID) ~ "_" ~ IntToString(_typeID), history[1] + 1);
}

//Returns the specified stage's history
function<int[]> Stage_GetSceneHistory(int _mode, int _playerID, int _stageID, int _typeID){
    int sceneSeen = GetAreaCommonData(AREA_SAVE, "StageSeen_" ~ IntToString(_mode) ~ "_" ~ IntToString(_playerID) ~ "_" ~ IntToString(_stageID) ~ "_" ~ IntToString(_typeID), 0);
    int sceneCleared = GetAreaCommonData(AREA_SAVE, "StageCleared_" ~ IntToString(_mode) ~ "_" ~ IntToString(_playerID) ~ "_" ~ IntToString(_stageID) ~ "_" ~ IntToString(_typeID), 0);
    return [sceneSeen, sceneCleared];
}

//Sets the current stage being fought
function<void> Stage_SetCurrentScene(int _stgID, int _typeID){
    SetAreaCommonData(AREA_STAGE, "StageCurrent", [_stgID, _typeID]);
}
//Returns the current stage being fought
function<int[]> Stage_GetCurrentScene(){
    return GetAreaCommonData(AREA_STAGE, "StageCurrent", [0, 0]);
}

