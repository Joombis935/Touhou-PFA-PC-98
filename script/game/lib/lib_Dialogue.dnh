//Marisa
//-----------------------------------------------------------------------
//Chooses the dialogue of the corresponding type
function<void> Marisa_Dialogue(int _index){
    alternative(_dialogueType)
    //Intro
    case(0) Marisa_DialogueIntro(_index);  //MUST BE DEFINED IN DIALOGUE SCRIPT
    //Outro
    case(1) Marisa_DialogueOutro(_index);  //MUST BE DEFINED IN DIALOGUE SCRIPT
}

