//Library for dialogue functions
//----------------------------- (26-character line limit for dialogue)
#include "script/game/lib/lib_SystemAll.dnh"
#include "script/game/lib/lib_File.dnh"
#include "script/game/lib/lib_Util.dnh"
#include "script/game/lib/bosslib/lib_Character.dnh"

//Important Globals
int _stgID = GetStageIndex();
int _plrID = GetPlayerType();
int _objPortPlayer;                        //Player portrait object
int _objPortBoss;                          //Boss portrait object
int _objTextPlayer;                        //Player text object
int _objTextBoss;                          //Boss text object
int _dialogueType = GetScriptArgument(0);  //Intro or outro dialogue
int indexCurrent = 0;                      //The current text index
int indexMax;                              //Last dialogue
int waitTime = 1;
int _holdSkip = 0;
bool _isSkipping = false;                  //Player is skipping through the dialogue scene
bool _isFlash = false;                     //White flash when boss sprite appears
bool _bEndDialogue = false;

//------------------------------------------------------------------------------------------------------------------
//Dialogue Scene Assembly
//------------------------------------------------------------------------------------------------------------------
task TDialogueScene(string _pathPortrait, int[] _dialogueIndices){
    //Freeze-frame background
    int objBG = InitSprite2D(0, 0, RT_SCREENSHOT, [0, 0, MAX_SCREEN_X, MAX_SCREEN_Y], RP_UI_BG);

    //Text boxes
    Dialogue_CreateTextBox(0);  //Player textbox
    Dialogue_CreateTextBox(1);  //Boss textbox
    wait(45);  //Animation
    //Portraits
    _objPortPlayer = Dialogue_CreatePlayerPortrait();
    _objPortBoss = Dialogue_CreateBossPortrait(_pathPortrait);
    Obj_SetVisible(_objPortBoss, false);
    //Text objects
    _objTextPlayer = Dialogue_CreateText(0);
    _objTextBoss = Dialogue_CreateText(1);
    CreateSkipText(31, MAX_SCREEN_Y - 16);

    alternative(_plrID)
    case(PLYR_REIMU)  indexMax = _dialogueType == 0 ? _dialogueIndices[0] : _dialogueIndices[1];
    case(PLYR_MARISA) indexMax = _dialogueType == 0 ? _dialogueIndices[2] : _dialogueIndices[3];
    case(PLYR_AUNN)   indexMax = _dialogueType == 0 ? _dialogueIndices[4] : _dialogueIndices[5];

    //Main dialogue loop (MUST BE DEFINED IN DIALOGUE SCRIPT)
    DialogueLoop();  //Defined in dialogue script because of differences in wait times between different scenes

    Obj_Delete(_objPortPlayer);
    Obj_Delete(_objPortBoss);
    Obj_Delete(_objTextPlayer);
    Obj_Delete(_objTextBoss);
    _bEndDialogue = true;

    wait(45);  //Textbox animation
    CloseScript(GetOwnScriptID());
}

//-----------------------------------------------------------------------
//Reimu
//-----------------------------------------------------------------------
//Chooses the dialogue of the corresponding type
function<void> Reimu_Dialogue(int _index){
    alternative(_dialogueType)
    //Intro
    case(0) Reimu_DialogueIntro(_index);  //MUST BE DEFINED IN DIALOGUE SCRIPT
    //Outro
    case(1) Reimu_DialogueOutro(_index);  //MUST BE DEFINED IN DIALOGUE SCRIPT
}

